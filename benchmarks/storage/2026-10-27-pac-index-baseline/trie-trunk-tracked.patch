+		return err
+	}
+	var f pil.Frame
+	if err = l.Scan(raw, &f); err != nil {
+		return err
+	}
+	items, err := pil.FieldValue(l.Definition.Fields[0], f.Values[0])
+	if err != nil {
+		return err
+	}
+	*out = make([][]byte, len(items.([]any)))
+	for i, v := range items.([]any) {
+		(*out)[i] = v.([]byte)
+	}
+	return nil
+}
