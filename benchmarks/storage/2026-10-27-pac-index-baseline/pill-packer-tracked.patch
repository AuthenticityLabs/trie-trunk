+    const bad=pac(invalid);codec.upload(bad);assert.throws(()=>codec.pac(id,0,bad.length,1),/schema/);
+    assert.throws(()=>codec.encodeJSON(id,'{"id":1,"customer":{},"items":[],"kind":"purchase"}'));
+  } finally {codec.release(id)}
+});
