# Local configuration, credentials, data, and backups.
.env
.env.*
!.env.example
/certs/
/taps/
/logs/
/caches/
.backups/

# Build outputs and dependencies at every crate/package level.
target/
node_modules/
build/
dist/
.vite/
.cache/
.wrangler/
*.tsbuildinfo
/web/

# WASM assets regenerated by client/scripts/build-pil.mjs.
/client/assets/pil.wasm
/client/assets/trunk-store.wasm

# Root executables; do not hide the go/cmd/trunk source directory.
/trunk
/trunk-search
/trunk-tantivy
/go/trunk
/benchmarks/storage/**/storage-bench
/benchmarks/storage/**/trunk-search

# Test, coverage, and profiling outputs.
coverage/
test-results/
playwright-report/
blob-report/
*.test
*.prof
*.pprof
coverage.out
coverage.xml
lcov.info

# Package-manager diagnostics and Python caches.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
__pycache__/
*.py[cod]

# Operating-system metadata and editor temporary files.
.DS_Store
._*
Thumbs.db
*.swp
*.swo
*.tmp
*~

# Isolated native ownership measurement binaries.
/benchmarks/native-boundary/build/

# Generated marketing site and visual verification artifacts.
/site/dist/
/site/artifacts/

# Regenerable bulk benchmark exports; retain reports, results and source snapshots.
/benchmarks/**/expanded.jsonl*
/benchmarks/**/payload.jsonl*
/benchmarks/**/*.sumday
/benchmarks/**/summaries/
/benchmarks/**/source.tar.gz

# Keep one public README; agent instructions, plans and reports stay local.
*.md
*.MD
!/README.md
.agents/
.codex/
