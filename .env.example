# Copy to .env in the directory where you run trunk, or use --env /path/to/file.
# Precedence: arguments > process environment > .env.<ENVIRONMENT> > .env > defaults.
# Values are literal; $VARIABLE, backslashes and shell commands are not expanded.

# Select a required profile such as .env.sand; empty uses only this base file.
ENVIRONMENT=
SERVER_NAME=trie-trunk
SERVER_TYPE=app
SERVER_INSTANCE=01

TRUNK_DIR=./taps
# Clients select the tap in their URL: /<tap>.
TRUNK_PORT=5140
TRUNK_HOST=127.0.0.1
TRUNK_TRANSPORT=websocket
TRUNK_NETWORK=tcp4
TRUNK_FLUSH=1s

# Search presentation only: listed fields first, then the remaining natural order.
# Names match exactly. Missing fields are skipped.
TRUNK_ENTRY_HEADERS=

# TLS 1.3: supply certificate and private-key file paths.
TRUNK_CERT=./certs/server.pem
TRUNK_KEY=./certs/server-key.pem

# This example selects mTLS: the client must present a certificate from this CA.
TRUNK_CLIENT_CA=./certs/client-ca.pem

# For bearer authentication instead, leave TRUNK_CLIENT_CA empty and set a
# secret TRUNK_TOKEN here or in the process environment. Both are required when
# configured together. No token is generated or included in this example.
TRUNK_TOKEN=

# HTTP/3: set TRUNK_TRANSPORT=http3 and TRUNK_NETWORK=udp4 (TLS/auth still required).
# Remote access: set TRUNK_HOST to the desired interface address.
# Local plaintext sandbox: leave CERT, KEY, CLIENT_CA and TOKEN empty; loopback only.

# Search serving: HTTP/2 on TCP and HTTP/3 on UDP at the same port.
# Reuses TRUNK_DIR, TRUNK_HOST, TRUNK_CERT, TRUNK_KEY, TRUNK_CLIENT_CA and TRUNK_TOKEN.
TRUNK_SERVE_PORT=443
TRUNK_WEB=./web
TRUNK_QUERIES=4
# Empty selects <TRUNK_DIR>/.trunk/search.sock, also the CLI's default endpoint.
TRUNK_SOCKET=
# Set for a remote search server; empty uses the local Unix socket.
TRUNK_ENDPOINT=
# Optional remote search TLS trust and client credentials; not used for sockets.
TRUNK_CA=
TRUNK_CLIENT_CERT=
TRUNK_CLIENT_KEY=
